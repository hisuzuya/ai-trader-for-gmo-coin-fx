{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ai-trade/config": ["../../packages/config/src/index.ts"],
      "@ai-trade/config/*": ["../../packages/config/src/*"],
      "@ai-trade/db": ["../../packages/db/src/index.ts"],
      "@ai-trade/db/*": ["../../packages/db/src/*"],
      "@ai-trade/domain": ["../../packages/domain/src/index.ts"],
      "@ai-trade/domain/*": ["../../packages/domain/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
