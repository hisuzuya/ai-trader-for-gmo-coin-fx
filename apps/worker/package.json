{
  "name": "@ai-trade/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.cjs",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-trade/config": "workspace:*",
    "@ai-trade/db": "workspace:*",
    "@ai-trade/domain": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.12.27"
  }
}
