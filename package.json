{
  "name": "ai-trader-for-gmo-coin-fx",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev:web": "pnpm --filter @ai-trade/web dev",
    "dev:worker": "pnpm --filter @ai-trade/worker dev",
    "dev:ai-runner": "pnpm --filter @ai-trade/ai-runner dev",
    "dev:mcp-agent-research": "pnpm --filter @ai-trade/mcp-agent-research start",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @ai-trade/db generate",
    "db:migrate": "pnpm --filter @ai-trade/db migrate",
    "lint": "node scripts/check-import-boundaries.mjs && biome ci .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@trpc/server": "^11.7.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.6",
    "next": "^16.0.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.7",
    "esbuild": "^0.27.7",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
